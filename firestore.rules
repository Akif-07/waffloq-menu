rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Müşteriler ve yönetim paneli siparişleri anlık okuyup yazabilir
    match /orders/{document=**} {
      allow read, write: if true;
    }
    // Menü ürünleri
    match /menuItems/{document=**} {
      allow read, write: if true;
    }
  }
}
